FROM rust:1.82-bookworm as builder

WORKDIR /app
COPY native-inference/ .
RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/pdm-native-inference /usr/local/bin/

# Python training bridge (thin layer)
COPY training_bridge/ /app/training_bridge/
RUN apt-get update && apt-get install -y python3 python3-pip && \
    pip3 install scikit-learn xgboost tensorflow skl2onnx onnxmltools tf2onnx numpy pandas && \
    rm -rf /var/lib/apt/lists/*

ENV MODELS_PATH=/app/models
ENV RUST_LOG=info

ENTRYPOINT ["pdm-native-inference"]
