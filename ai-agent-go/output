package main

import (
	"context"
	"encoding/json"
	"fmt"
	"sort"
	"strconv"
	"strings"
	"sync"
	"time"
)

const (
	systemPrompt = `You are an operations agent with access to a ThingsBoard MCP server. Your job is to answer questions about alarms accurately, using live data only - never guess, infer, or fabricate alarm state.

Call the ThingsBoard alarm-listing tool with these parameters:
- searchStatus: use "ACTIVE" when the user asks for live, current, active, or open alarms. Use "ANY" only if the user explicitly wants historical or cleared alarms too. Never mix searchStatus and status in the same call.
- fetchOriginator: always true.
- sortProperty: "createdTime", sortOrder: "DESC".
- page: 0, pageSize: 50. Use totalElements for the count, and only fetch additional pages up to the configured live-alarm page limit before summarizing.
- startTs / endTs: only set these if the user specifies a time window.
- textSearch: only set if the user is filtering by a specific type, severity, or status keyword.

Rules:
1. Never answer from memory or assumption. Always call the tool first when asked about alarm state.
2. Report only what the response contains. Pull directly from the JSON fields type, severity, status, originatorName or originatorDisplayName, acknowledged, cleared, assignee, and createdTime.
3. Convert createdTime from epoch milliseconds to a readable local timestamp before presenting it.
4. Zero alarms is a valid, reportable state. If totalElements is 0, say "No active alarms".
5. Summarize in a table when there are 2 or more alarms: Type | Severity | Status | Originator | Created.
6. State counts explicitly: "There are currently N active alarms".
7. Offer next actions relevant to alarms specifically - acknowledge, clear, or fetch full details/history - but only execute them after explicit user confirmation.
8. On tool error or empty/malformed response, say so plainly rather than presenting a guessed answer.
9. If asked how you reached a conclusion, state exactly which tool and parameters you called and which JSON fields you read.

Output format:
There are currently N active alarms:

| Type | Severity | Status | Originator | Created |
|---|---|---|---|---|
| ... | ... | ... | ... | ... |

- Acknowledged: Yes/No
- Cleared: Yes/No
- Assignee: [name or "None"]

Want me to acknowledge, clear, or pull more detail on any of these?`
	liveQueryHint            = "For live, active, current, or online device/sensor questions, use EDQ tools instead of generic list/get tools.\nPrefer findEntityDataByEntityTypeFilter for DEVICE queries.\nPrefer findEntityDataByDeviceSearchQueryFilter only when the question explicitly asks for devices related to another root entity.\nInclude latest telemetry when it helps identify the current state, and prefer active=true if that field is available.\nDo not ask the user to provide function schemas, examples, or extra help for live-device queries."
	liveAlarmPageSize        = "50"
	defaultMaxLiveAlarmPages = 1
)

type mcpToolClient interface {
	ListTools(ctx context.Context) ([]McpTool, error)
	CallTool(ctx context.Context, name string, arguments map[string]any) (string, error)
}

type Agent struct {
	settings   Settings
	mcp        mcpToolClient
	ollama     *OllamaClient
	planner    *Planner
	toolsMu    sync.Mutex
	tools      []McpTool
	sessionsMu sync.Mutex
	sessions   map[string][]Message
}

func NewAgent(settings Settings, mcp mcpToolClient, ollama *OllamaClient) *Agent {
	return &Agent{
		settings: settings,
		mcp:      mcp,
		ollama:   ollama,
		planner:  &Planner{llm: ollama},
		sessions: map[string][]Message{},
	}
}

func (a *Agent) RefreshTools(ctx context.Context) (int, error) {
	tools, err := a.mcp.ListTools(ctx)
	if err != nil {
		return 0, err
	}
	a.toolsMu.Lock()
	a.tools = append([]McpTool(nil), tools...)
	a.toolsMu.Unlock()
	return len(tools), nil
}

func (a *Agent) RunAgent(ctx context.Context, query string, extraContext map[string]any, model *string, sessionID *string, progress func(TrajectoryStep)) (AgentResult, error) {
	if len(a.toolsSnapshot()) == 0 {
		if _, err := a.RefreshTools(ctx); err != nil {
			return AgentResult{}, err
		}
	}
	if sessionID == nil || *sessionID == "" {
		id := newID()
		sessionID = &id
	}
	if extraContext != nil {
		query = "Context:\n" + prettyJSON(extraContext) + "\n\nQuery:\n" + query
	}

	history := a.getSessionMessages(*sessionID)
	if len(history) == 0 {
		history = []Message{{Role: "system", Content: systemPrompt}}
	}
	if isLiveAlarmQuery(query) {
		history = append(history, Message{Role: "system", Content: "Use getAllAlarms with searchStatus=ACTIVE, fetchOriginator=true, sortProperty=createdTime, sortOrder=DESC, page=0, and pageSize=50. Use totalElements for the active count, and only fetch additional pages up to the configured live-alarm page limit. Report only the fields returned by the alarm objects."})
		return a.runLiveAlarmQuery(ctx, query, history, *sessionID, progress)
	}
	if isLiveEntityQuery(query) {
		history = append(history, Message{Role: "system", Content: liveQueryHint})
		return a.runLiveEntityQuery(ctx, query, history, model, *sessionID, progress)
	}

	history = append(history, Message{Role: "user", Content: query})
	serverDescriptions := a.serverDescriptions()
	plan, err := a.planner.GeneratePlan(query, serverDescriptions)
	if err != nil {
		answer, fallbackErr := a.directAnswer(ctx, history, model)
		if fallbackErr != nil {
			return AgentResult{}, err
		}
		a.storeSessionMessages(*sessionID, append(history, Message{Role: "assistant", Content: answer}))
		return resultForAnswer(answer, "llm_error", nil, *sessionID), nil
	}

	steps := plan.ResolvedOrder()
	if a.settings.MaxSteps > 0 && len(steps) > a.settings.MaxSteps {
		steps = steps[:a.settings.MaxSteps]
	}

	trajectory := make([]TrajectoryStep, 0, len(steps))
	evidenceTrajectory := make([]TrajectoryStep, 0, len(steps))
	contextByStep := map[int]StepResult{}
	toolCallsUsed := 0
	for _, step := range steps {
		if step.Tool == "" || strings.EqualFold(step.Tool, "none") || strings.EqualFold(step.Tool, "null") {
			entry := TrajectoryStep{
				Step:        step.StepNumber,
				Action:      "FINISH",
				Observation: "No tool call was needed.",
			}
			trajectory = append(trajectory, entry)
			if progress != nil {
				progress(entry)
			}
			continue
		}
		toolCallsUsed++

		toolSchema := a.toolSchema(step.Tool)
		started := time.Now()
		resolvedArgs, resolveErr := a.ollama.ResolveArgs(query, step.Task, step.Tool, toolSchema, contextByStep)
		if resolveErr != nil {
			resolvedArgs = map[string]any{}
		}
		response, callErr := a.mcp.CallTool(ctx, step.Tool, resolvedArgs)
		if callErr != nil {
			response = fmt.Sprintf("[MCP tool error calling %q] %v", step.Tool, callErr)
		}
		response = trimText(response, a.settings.MaxObservationChars)
		entry := TrajectoryStep{
			Step:        step.StepNumber,
			Action:      step.Tool,
			ActionInput: resolvedArgs,
			Observation: response,
			ElapsedMs:   int(time.Since(started).Milliseconds()),
		}
		trajectory = append(trajectory, entry)
		evidenceTrajectory = append(evidenceTrajectory, entry)
		if progress != nil {
			progress(entry)
		}
		contextByStep[step.StepNumber] = StepResult{Response: response}
	}

	if toolCallsUsed == 0 {
		answer := "I could not verify any tool-backed results from the available MCP tools for this request. Please provide a specific asset, site, device, alarm, or other scope so I can query the source system."
		a.storeSessionMessages(*sessionID, append(history, Message{Role: "assistant", Content: answer}))
		return resultForAnswer(answer, "finished", trajectory, *sessionID), nil
	}

	answer, err := a.ollama.SynthesizeAnswer(query, evidenceTrajectory, plan, history)
	if err != nil || strings.TrimSpace(answer) == "" {
		answer = lastObservation(evidenceTrajectory)
		if answer == "" {
			answer = "No answer could be produced."
		}
	}
	a.storeSessionMessages(*sessionID, append(history, Message{Role: "assistant", Content: answer}))
	return resultForAnswer(answer, "finished", trajectory, *sessionID), nil
}

func (a *Agent) directAnswer(ctx context.Context, history []Message, model *string) (string, error) {
	_ = ctx
	message, err := a.ollama.Chat(history, model)
	if err != nil {
		return "", err
	}
	return strings.TrimSpace(message.Content), nil
}

func (a *Agent) runLiveEntityQuery(ctx context.Context, query string, history []Message, model *string, sessionID string, progress func(TrajectoryStep)) (AgentResult, error) {
	_ = query
	_ = model
	requestArguments := map[string]any{
		"entityTypeFilterJson": `{"type":"entityType","entityType":"DEVICE"}`,
		"entityFieldsJson": `[
			{"type":"ENTITY_FIELD","key":"name"},
			{"type":"ENTITY_FIELD","key":"type"},
			{"type":"ENTITY_FIELD","key":"label"},
			{"type":"ENTITY_FIELD","key":"createdTime"}
		]`,
		"latestValuesJson": `[{"type":"TIME_SERIES","key":"lastActivityTime"}]`,
		"pageSize":         "100",
		"page":             "0",
	}
	started := time.Now()
	rawResult, err := a.mcp.CallTool(ctx, "findEntityDataByEntityTypeFilter", requestArguments)
	if err != nil {
		answer := fmt.Sprintf("Failed to query live devices from ThingsBoard MCP: %v", err)
		trajectory := []TrajectoryStep{{
			Step:        1,
			Action:      "findEntityDataByEntityTypeFilter",
			ActionInput: requestArguments,
			Observation: answer,
			ElapsedMs:   int(time.Since(started).Milliseconds()),
		}}
		return resultForAnswer(answer, "llm_error", trajectory, sessionID), nil
	}
	observation := trimText(rawResult, 4000)
	trajectory := []TrajectoryStep{{
		Step:        1,
		Action:      "findEntityDataByEntityTypeFilter",
		ActionInput: requestArguments,
		Observation: observation,
		ElapsedMs:   int(time.Since(started).Milliseconds()),
	}}
	if progress != nil {
		progress(trajectory[0])
	}
	answer := summarizeLiveDevices(rawResult)
	a.storeSessionMessages(sessionID, append(history, Message{Role: "assistant", Content: answer}))
	return resultForAnswer(answer, "finished", trajectory, sessionID), nil
}

func (a *Agent) runLiveAlarmQuery(ctx context.Context, query string, history []Message, sessionID string, progress func(TrajectoryStep)) (AgentResult, error) {
	_ = query
	alarms := make([]map[string]any, 0)
	trajectory := make([]TrajectoryStep, 0)
	totalElements := 0
	hasMore := false
	maxPages := maxLiveAlarmPages(a.settings)
	for page := 0; page < maxPages; page++ {
		requestArguments := map[string]any{
			"searchStatus":    "ACTIVE",
			"fetchOriginator": true,
			"sortProperty":    "createdTime",
			"sortOrder":       "DESC",
			"page":            fmt.Sprintf("%d", page),
			"pageSize":        liveAlarmPageSize,
		}
		started := time.Now()
		rawResult, err := a.mcp.CallTool(ctx, "getAllAlarms", requestArguments)
		if err != nil {
			answer := fmt.Sprintf("Failed to query live alarms from ThingsBoard MCP: %v", err)
			trajectory = append(trajectory, TrajectoryStep{
				Step:        page + 1,
				Action:      "getAllAlarms",
				ActionInput: requestArguments,
				Observation: answer,
				ElapsedMs:   int(time.Since(started).Milliseconds()),
			})
			return resultForAnswer(answer, "llm_error", trajectory, sessionID), nil
		}
		pageData, err := parseAlarmPageData(rawResult)
		if err != nil {
			answer := fmt.Sprintf("The ThingsBoard alarm query returned malformed data: %v", err)
			trajectory = append(trajectory, TrajectoryStep{
				Step:        page + 1,
				Action:      "getAllAlarms",
				ActionInput: requestArguments,
				Observation: trimText(rawResult, a.settings.MaxObservationChars),
				ElapsedMs:   int(time.Since(started).Milliseconds()),
			})
			return resultForAnswer(answer, "llm_error", trajectory, sessionID), nil
		}
		if pageData.TotalElements > totalElements {
			totalElements = pageData.TotalElements
		}
		hasMore = pageData.HasNext
		alarms = append(alarms, pageData.Data...)
		observation := trimText(rawResult, 4000)
		entry := TrajectoryStep{
			Step:        page + 1,
			Action:      "getAllAlarms",
			ActionInput: requestArguments,
			Observation: observation,
			ElapsedMs:   int(time.Since(started).Milliseconds()),
		}
		trajectory = append(trajectory, entry)
		if progress != nil {
			progress(entry)
		}
		if !pageData.HasNext {
			break
		}
	}

	if totalElements < len(alarms) {
		totalElements = len(alarms)
	}
	answer := summarizeLiveAlarms(alarms, totalElements, hasMore)
	a.storeSessionMessages(sessionID, append(history, Message{Role: "assistant", Content: answer}))
	return resultForAnswer(answer, "finished", trajectory, sessionID), nil
}

func (a *Agent) serverDescriptions() map[string]string {
	tools := a.toolsSnapshot()
	lines := make([]string, 0, len(tools))
	for _, tool := range tools {
		lines = append(lines, fmt.Sprintf("  - %s(%s): %s", tool.Name, formatSchema(tool.InputSchema), tool.Description))
	}
	sort.Strings(lines)
	return map[string]string{"thingsboard": strings.Join(lines, "\n")}
}

func (a *Agent) toolSchema(toolName string) string {
	for _, item := range a.toolsSnapshot() {
		if item.Name == toolName {
			return fmt.Sprintf("%s(%s) - %s", item.Name, formatSchema(item.InputSchema), item.Description)
		}
	}
	return "(unknown)"
}

func (a *Agent) toolsSnapshot() []McpTool {
	a.toolsMu.Lock()
	defer a.toolsMu.Unlock()
	return append([]McpTool(nil), a.tools...)
}

func (a *Agent) getSessionMessages(sessionID string) []Message {
	a.sessionsMu.Lock()
	defer a.sessionsMu.Unlock()
	messages := a.sessions[sessionID]
	copyMessages := make([]Message, len(messages))
	copy(copyMessages, messages)
	return copyMessages
}

func (a *Agent) storeSessionMessages(sessionID string, messages []Message) {
	history := messages
	if len(history) > 20 {
		history = history[len(history)-20:]
	}
	copyMessages := make([]Message, len(history))
	copy(copyMessages, history)
	a.sessionsMu.Lock()
	a.sessions[sessionID] = copyMessages
	a.sessionsMu.Unlock()
}

func formatSchema(schema map[string]any) string {
	if len(schema) == 0 {
		return ""
	}
	props, _ := schema["properties"].(map[string]any)
	requiredSet := map[string]bool{}
	if required, ok := schema["required"].([]any); ok {
		for _, item := range required {
			requiredSet[fmt.Sprint(item)] = true
		}
	}
	if required, ok := schema["required"].([]string); ok {
		for _, item := range required {
			requiredSet[item] = true
		}
	}
	keys := make([]string, 0, len(props))
	for key := range props {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	parts := make([]string, 0, len(keys))
	for _, key := range keys {
		suffix := "?"
		if requiredSet[key] {
			suffix = ""
		}
		parts = append(parts, key+suffix+": "+schemaType(props[key]))
	}
	return strings.Join(parts, ", ")
}

func schemaType(value any) string {
	if typed, ok := value.(map[string]any); ok {
		if t := fmt.Sprint(typed["type"]); t != "<nil>" && t != "" {
			return t
		}
	}
	return "any"
}

func summarizeLiveDevices(rawResult string) string {
	var parsed map[string]any
	if err := json.Unmarshal([]byte(rawResult), &parsed); err != nil {
		return rawResult
	}
	devices, _ := parsed["data"].([]any)
	if len(devices) == 0 {
		return "No live devices were returned by ThingsBoard MCP."
	}
	lines := []string{"Live devices currently available:"}
	for i, device := range devices {
		item, _ := device.(map[string]any)
		name := nestedValue(item, "latest", "ENTITY_FIELD", "name", "value")
		if name == "" {
			name = nestedValue(item, "name")
		}
		if name == "" {
			name = nestedValue(item, "entityId", "id")
		}
		if name == "" {
			name = fmt.Sprintf("device-%d", i+1)
		}
		label := nestedValue(item, "latest", "ENTITY_FIELD", "label", "value")
		if label == "" {
			label = nestedValue(item, "label")
		}
		if label != "" {
			lines = append(lines, fmt.Sprintf("- %s (%s)", name, label))
			continue
		}
		lines = append(lines, "- "+name)
	}
	return strings.Join(lines, "\n")
}

type alarmPageData struct {
	Data          []map[string]any `json:"data"`
	TotalElements int              `json:"totalElements"`
	HasNext       bool             `json:"hasNext"`
}

func maxLiveAlarmPages(settings Settings) int {
	if settings.MaxAlarmPages > 0 {
		return settings.MaxAlarmPages
	}
	return defaultMaxLiveAlarmPages
}

func parseAlarmPageData(rawResult string) (alarmPageData, error) {
	var parsed alarmPageData
	if err := json.Unmarshal([]byte(rawResult), &parsed); err != nil {
		return alarmPageData{}, err
	}
	return parsed, nil
}

func summarizeLiveAlarms(alarms []map[string]any, totalElements int, hasMore bool) string {
	if totalElements <= 0 && len(alarms) == 0 {
		return "No active alarms"
	}
	if totalElements < len(alarms) {
		totalElements = len(alarms)
	}

	lines := []string{fmt.Sprintf("There are currently %d active alarms:", totalElements)}
	if hasMore && len(alarms) > 0 && totalElements > len(alarms) {
		lines = append(lines, fmt.Sprintf("Showing the %d newest active alarms returned by ThingsBoard.", len(alarms)))
	}
	if len(alarms) == 0 {
		lines = append(lines, "", "ThingsBoard did not return alarm details for this page.")
		return strings.Join(lines, "\n")
	}

	lines = append(lines, "", "| Type | Severity | Status | Originator | Created |", "|---|---|---|---|---|")
	for _, alarm := range alarms {
		typeName := alarmField(alarm, "type")
		severity := alarmField(alarm, "severity")
		status := alarmField(alarm, "status")
		originator := alarmField(alarm, "originatorName")
		if originator == "" {
			originator = alarmField(alarm, "originatorDisplayName")
		}
		created := formatAlarmCreatedTime(alarmField(alarm, "createdTime"))
		lines = append(lines, fmt.Sprintf("| %s | %s | %s | %s | %s |", cellOrDash(typeName), cellOrDash(severity), cellOrDash(status), cellOrDash(originator), cellOrDash(created)))
	}

	lines = append(lines, "")
	for index, alarm := range alarms {
		assignee := alarmField(alarm, "assignee")
		if assignee == "" {
			assignee = "None"
		}
		lines = append(lines, fmt.Sprintf("- Alarm %d: Acknowledged: %s, Cleared: %s, Assignee: %s", index+1, boolOrNo(alarm["acknowledged"]), boolOrNo(alarm["cleared"]), assignee))
	}
	if hasMore && totalElements > len(alarms) {
		lines = append(lines, fmt.Sprintf("- %d more active alarms were not expanded to keep the live query responsive.", totalElements-len(alarms)))
	}
	lines = append(lines, "", "Want me to acknowledge, clear, or pull more detail on any of these?")
	return strings.Join(lines, "\n")
}

func alarmField(alarm map[string]any, key string) string {
	if alarm == nil {
		return ""
	}
	raw := alarm[key]
	var value string
	switch typed := raw.(type) {
	case nil:
		return ""
	case float64:
		value = strconv.FormatFloat(typed, 'f', -1, 64)
	case float32:
		value = strconv.FormatFloat(float64(typed), 'f', -1, 32)
	default:
		value = fmt.Sprint(typed)
	}
	value = strings.TrimSpace(value)
	if value == "<nil>" {
		return ""
	}
	return value
}

func formatAlarmCreatedTime(raw string) string {
	if raw == "" {
		return ""
	}
	ms, err := strconv.ParseInt(raw, 10, 64)
	if err == nil {
		return time.UnixMilli(ms).In(time.Local).Format("2006-01-02 15:04:05 MST")
	}
	msFloat, err := strconv.ParseFloat(raw, 64)
	if err != nil {
		return raw
	}
	return time.UnixMilli(int64(msFloat)).In(time.Local).Format("2006-01-02 15:04:05 MST")
}

func cellOrDash(value string) string {
	if strings.TrimSpace(value) == "" {
		return "-"
	}
	return value
}

func boolOrNo(value any) string {
	if typed, ok := value.(bool); ok && typed {
		return "Yes"
	}
	return "No"
}

func nestedValue(data map[string]any, path ...string) string {
	current := any(data)
	for _, key := range path {
		currentMap, ok := current.(map[string]any)
		if !ok {
			return ""
		}
		current = currentMap[key]
	}
	value := strings.TrimSpace(fmt.Sprint(current))
	if value == "<nil>" || value == "" {
		return ""
	}
	return value
}

func isLiveEntityQuery(query string) bool {
	text := strings.ToLower(query)
	liveTerms := []string{"live", "active", "online", "current", "latest", "telemetry"}
	entityTerms := []string{"device", "devices", "sensor", "sensors"}
	for _, live := range liveTerms {
		if !strings.Contains(text, live) {
			continue
		}
		for _, entity := range entityTerms {
			if strings.Contains(text, entity) {
				return true
			}
		}
	}
	return false
}

func isLiveAlarmQuery(query string) bool {
	text := strings.ToLower(query)
	alarmTerms := []string{"alarm", "alarms"}
	liveTerms := []string{"live", "active", "open", "current", "latest"}
	for _, alarmTerm := range alarmTerms {
		if !strings.Contains(text, alarmTerm) {
			continue
		}
		for _, liveTerm := range liveTerms {
			if strings.Contains(text, liveTerm) {
				return true
			}
		}
	}
	return false
}

