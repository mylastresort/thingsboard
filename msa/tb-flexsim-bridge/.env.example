PORT=8095
LOG_LEVEL=info

# ThingsBoard MQTT settings.
TB_MQTT_URL=mqtt://localhost:1883
TB_MQTT_CLIENT_ID=tb-flexsim-bridge
TB_MQTT_PUBLISH_QOS=1

# Optional map between device names and tokens used when sending telemetry to ThingsBoard.
# Example: pump_1:abc123,conveyor_2:def456
TB_DEVICE_TOKEN_MAP=

# Default device token if request does not provide one.
TB_DEFAULT_DEVICE_TOKEN=

# FlexSim endpoint used for telemetry ingestion.
FLEXSIM_INGEST_URL=http://localhost:8088/api/thingsboard/ingest
FLEXSIM_API_TIMEOUT_MS=5000

# Optional static token for calls into FlexSim.
FLEXSIM_API_TOKEN=
