  "panels": [
    {
      "title": "Commands Received",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum(rate(pdm_commands_received_total[1m])) by (command_type, model_type)",
