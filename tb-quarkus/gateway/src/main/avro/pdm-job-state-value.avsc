{
  "type": "record",
  "name": "JobState",
  "namespace": "com.um6p.pdm.jobstate",
  "fields": [
    { "name": "modelId", "type": "string" },
    { "name": "modelType", "type": "string" },
    { "name": "deviceId", "type": ["null", "string"], "default": null },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "JobStatus",
        "symbols": ["INITIALIZED", "TRAINING", "RUNNING", "PAUSED", "STOPPED", "ERROR"]
      }
    },
    { "name": "paused", "type": "boolean", "default": false },
    { "name": "iterations", "type": "int", "default": 0 },
    {
      "name": "startTime",
      "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
      "default": null
    },
    {
      "name": "lastRun",
      "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }],
      "default": null
    }
  ]
}
